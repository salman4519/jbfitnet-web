# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (optional, defaults to jbfitnet)
MONGODB_DB=jbfitnet
# Overrides the contact email shown on the site (optional, defaults to jbfitnet@gmail.com)
NEXT_PUBLIC_CONTACT_EMAIL=
# Password for the /admin panel. Use a long random value.
ADMIN_PASSWORD=
# Optional: separate key for signing admin sessions
ADMIN_SESSION_SECRET=
